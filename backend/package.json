{
  "name": "defensores-casanare-backend",
  "version": "1.0.0",
  "description": "Backend API for Defensores de la Patria - Casanare form",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:init": "ts-node src/infra/scripts/init-db.ts",
    "db:test": "node scripts/test-connection.js",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && serverless deploy",
    "deploy:dev": "npm run build && serverless deploy --stage dev",
    "deploy:prod": "npm run build && serverless deploy --stage prod"
  },
  "dependencies": {
    "dotenv": "^16.0.0",
    "exceljs": "^4.2.0",
    "express": "^4.18.0",
    "jsonwebtoken": "^9.0.0",
    "mysql2": "^3.0.0",
    "serverless-http": "^3.0.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^20.0.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "serverless": "^3.0.0",
    "serverless-offline": "^12.0.0",
    "serverless-plugin-tracing": "^2.0.0",
    "ts-node": "^10.0.0",
    "typescript": "^5.0.0"
  }
}
